          "serotonin": "unknown"
        },
        "basis": {
          "acetylcholine": "Cholinergic central neurons of Drosophila are reported to act through fast excitatory nicotinic receptors, so the rule fixes the sign at +1.",
          "dopamine": "Dopamine acts through several G-protein-coupled receptor types whose effect depends on the receptor the postsynaptic cell expresses, which the release does not report, so the sign stays unknown.",
          "gaba": "GABA is reported to act through the Rdl GABA-A chloride conductance in the fly central nervous system, so the rule fixes the sign at -1.",
          "glutamate": "Fly glutamatergic connections are frequently inhibitory through the GluCl chloride channel while excitatory glutamate receptors also exist, so a fixed -1 is an engineering 假設 (engineering assumption) recorded here, not evidence in the release.",
          "histamine": "Histamine is reported to gate the ort/HisCl chloride channels in the fly, so the rule fixes the sign at -1.",
          "octopamine": "Octopamine is a modulator acting through G-protein-coupled receptors whose effect depends on the postsynaptic receptor, which the release does not report, so the sign stays unknown.",
          "serotonin": "Serotonin acts through several G-protein-coupled receptor subtypes with opposite effects depending on the receptor, which the release does not report, so the sign stays unknown."
        },
        "min_probability": 0.5,
        "min_matched_fraction": 0.5
      },
