{
  "schema_version": "coimnet-simulate-compare/v1",
  "run": {
  "schema_version": "coimnet-simulate-protocol/v1",
  "core": "lif",
  "lif": {
    "dt": 1,
    "tau_syn": 5,
    "theta_min": 0.1,
    "theta_max": 2,
    "v_reset": -0.5,
    "refractory_steps": 1,
    "adaptation": {
      "enabled": false,
      "tau_adapt": 0,
      "beta": 0
    },
    "surrogate": {
      "kind": "fast_sigmoid",
      "scale": 2
    }
  },
  "injection_groups": [
    {
      "channel": 0,
      "selector": {
        "field": "class",
        "equals": "ALIN"
      },
      "gain": 1
    }
  ],
  "probes": [
    {
      "name": "alin_injected_spikes",
      "selector": {
        "field": "class",
        "equals": "ALIN"
      },
      "reduce": "spike_fraction"
    },
    {
      "name": "alin_injected_trace",
      "selector": {
        "field": "class",
        "equals": "ALIN"
      },
      "reduce": "mean_output"
    },
    {
      "name": "descending_neuron_spikes",
      "selector": {
        "field": "superclass",
        "equals": "descending_neuron"
      },
      "reduce": "spike_fraction"
    },
    {
      "name": "vnc_motor_spikes",
      "selector": {
        "field": "superclass",
        "equals": "vnc_motor"
      },
      "reduce": "spike_fraction"
    }
  ],
  "stimulus": {
    "pulse": {
      "channels": 1,
      "steps": 300,
      "channel": 0,
      "onset": 10,
      "duration": 20,
      "amplitude": 2
    }
  },
  "thresholds": {
    "max_population_rate": 0.2,
    "min_active_fraction": 0.01
  },
  "parameter_source": "derived_release/v1",
  "uniform": {
    "gain": 0,
    "bias": 0,
    "log_tau": 0,
    "theta_raw": 0
  },
  "derived": {
    "unknown_sign": "exclude",
    "weight_scale": 21.6
  }
},
  "sets": [
    {
      "name": "alin",
      "selectors": [
        {
          "field": "class",
          "equals": "ALIN"
        }
      ]
    },
    {
      "name": "descending_neuron",
      "selectors": [
        {
          "field": "superclass",
          "equals": "descending_neuron"
        }
      ]
    },
    {
      "name": "vnc_motor",
      "selectors": [
        {
          "field": "superclass",
          "equals": "vnc_motor"
        }
      ]
    }
  ],
  "metrics": [
    {
      "name": "alin_spike_fraction",
      "kind": "spike_fraction",
      "set": "alin",
      "window": [10, 300]
    },
    {
      "name": "alin_mean_rate",
      "kind": "mean_rate",
      "set": "alin",
      "window": [30, 300]
    },
    {
      "name": "alin_latency",
      "kind": "latency_to_first_spike",
      "set": "alin",
      "window": [10, 300]
    },
    {
      "name": "alin_activity_ratio",
      "kind": "activity_ratio_vs_baseline",
      "set": "alin",
      "window": [30, 300],
      "baseline": [10, 30]
    },
    {
      "name": "descending_neuron_spike_fraction",
      "kind": "spike_fraction",
      "set": "descending_neuron",
      "window": [10, 300]
    },
    {
      "name": "descending_neuron_mean_rate",
      "kind": "mean_rate",
      "set": "descending_neuron",
      "window": [30, 300]
    },
    {
      "name": "descending_neuron_latency",
      "kind": "latency_to_first_spike",
      "set": "descending_neuron",
      "window": [10, 300]
    },
    {
      "name": "descending_neuron_activity_ratio",
      "kind": "activity_ratio_vs_baseline",
      "set": "descending_neuron",
      "window": [30, 300],
      "baseline": [10, 30]
    },
    {
      "name": "vnc_motor_spike_fraction",
      "kind": "spike_fraction",
      "set": "vnc_motor",
      "window": [10, 300]
    },
    {
      "name": "vnc_motor_mean_rate",
      "kind": "mean_rate",
      "set": "vnc_motor",
      "window": [30, 300]
    },
    {
      "name": "vnc_motor_latency",
      "kind": "latency_to_first_spike",
      "set": "vnc_motor",
      "window": [10, 300]
    },
    {
      "name": "vnc_motor_activity_ratio",
      "kind": "activity_ratio_vs_baseline",
      "set": "vnc_motor",
      "window": [30, 300],
      "baseline": [10, 30]
    }
  ],
  "thresholds": [
    {
      "metric": "alin_spike_fraction",
      "op": ">=",
      "value": 0.5
    },
    {
      "metric": "descending_neuron_spike_fraction",
      "op": ">=",
      "value": 0.1
    },
    {
      "metric": "vnc_motor_spike_fraction",
      "op": ">=",
      "value": 0.1
    },
    {
      "metric": "descending_neuron_latency",
      "op": "<",
      "value": 100
    },
    {
      "metric": "vnc_motor_latency",
      "op": "<",
      "value": 150
    }
  ],
  "null_models": [
    {
      "kind": "degree_preserving_rewire",
      "swap_factor": 1
    },
    {
      "kind": "sign_shuffle"
    },
    {
      "kind": "weight_shuffle"
    }
  ],
  "seeds": [1, 2, 3]
}
